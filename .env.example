# Copy to .env.local and fill in from Supabase: Project Settings > API
# Leave these empty to run in demo mode.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Never prefix with NEXT_PUBLIC_ and never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Day #1 of SOC Daily (YYYY-MM-DD). Used for challenge numbers.
NEXT_PUBLIC_LAUNCH_DATE=2026-10-27
